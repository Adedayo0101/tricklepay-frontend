# Local environment for the TricklePay frontend.
#
#   cp .env.example .env.local
#
# .env.local and .env are both gitignored; .env.local wins where they overlap.
# These are NEXT_PUBLIC_* values, so Next.js inlines them into the client bundle
# at build time — restart `npm run dev` (or re-run `npm run build`) after an
# edit, or the change will not take effect.
#
# Full walkthrough: docs/local-setup.md

# Base URL of the tricklepay-backend read API.
# The backend also defaults to port 3000, so run the frontend elsewhere
# (`npm run dev -- --port 3001`) or point this at the port you moved it to.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Milliseconds a backend read API request may take before it is aborted.
# Raise it for a slow or cold backend; 0 disables the timeout entirely.
# Optional, defaults to 10000. Does not affect on-chain transactions, which
# have their own confirmation budget.
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Stellar network: testnet or mainnet.
# Must match the network selected in the Freighter extension, or signing is
# blocked with a mismatch warning.
NEXT_PUBLIC_NETWORK=testnet

# Soroban RPC endpoint, used to submit signed transactions.
# Defaults to the public endpoint for the network above.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Deployed stream contract id: 56 characters, starts with C.
# Required — the app validates this as it boots and refuses to start without a
# valid value. Take it from your tricklepay-contracts deploy output.
NEXT_PUBLIC_CONTRACT_ID=

# Absolute base URL of this deployment, used to build canonical and social
# (Open Graph/Twitter) metadata URLs. Build-time only, like the other
# NEXT_PUBLIC_* values above. Optional — left unset, those URLs are omitted
# rather than pointing at a domain this deployment doesn't control.
NEXT_PUBLIC_APP_URL=

# Serve built-in fixture streams instead of calling the backend, for layout and
# styling work without the API or a database running. Also fills in a
# placeholder contract id when NEXT_PUBLIC_CONTRACT_ID is empty. On-chain
# writes still need a real deployment. Optional, off unless set to true.
NEXT_PUBLIC_MOCK_API=false
